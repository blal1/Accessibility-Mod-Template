<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- IMPORTANT: take TargetFramework from the MelonLoader log!
         Runtime Type: net35 → net472 (NOT netstandard2.0!)
         Runtime Type: net6  → net6.0 -->
    <TargetFramework>TARGET_FRAMEWORK</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>

    <AssemblyName>MODNAME</AssemblyName>
    <RootNamespace>NAMESPACE</RootNamespace>
  </PropertyGroup>

  <!-- IMPORTANT: keep decompiled game code and tooling out of the build! -->
  <ItemGroup>
    <Compile Remove="decompiled\**" />
    <Compile Remove="templates\**" />
    <Compile Remove="Tests\**" />
    <Compile Remove="recon\**" />
  </ItemGroup>

  <!-- Localization: Localization/<language>/<Feature>.txt (KEY<TAB>TEXT<TAB>COMMENT) are embedded in the DLL.
       LocalizationUtils reads them as resources "Localization/<language>/<file>". See docs/03-architecture.md -->
  <ItemGroup>
    <EmbeddedResource Include="Localization\**\*.txt" LogicalName="Localization/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- MelonLoader references
       IMPORTANT: the folder must match the Runtime Type (net35/ or net6/) -->
  <ItemGroup>
    <Reference Include="MelonLoader">
      <HintPath>GAME_FOLDER\MelonLoader\RUNTIME_FOLDER\MelonLoader.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>GAME_FOLDER\MelonLoader\RUNTIME_FOLDER\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Unity references (from the game's Managed folder) -->
  <ItemGroup>
    <Reference Include="UnityEngine">
      <HintPath>GAME_FOLDER\GAME_NAME_Data\Managed\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>GAME_FOLDER\GAME_NAME_Data\Managed\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>GAME_FOLDER\GAME_NAME_Data\Managed\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>GAME_FOLDER\GAME_NAME_Data\Managed\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- TextMeshPro: most Unity games show text with it (ReflectionHelper and AccessibleFEATURENAME use TMPro.TMP_Text). Remove if the game has no Unity.TextMeshPro.dll. -->
    <Reference Include="Unity.TextMeshPro">
      <HintPath>GAME_FOLDER\GAME_NAME_Data\Managed\Unity.TextMeshPro.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>GAME_FOLDER\GAME_NAME_Data\Managed\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Game assembly -->
  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>GAME_FOLDER\GAME_NAME_Data\Managed\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- After build: copy the DLL to the Mods folder -->
  <Target Name="CopyToMods" AfterTargets="Build">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="GAME_FOLDER\Mods\" />
    <Message Text="Copied $(TargetFileName) to Mods folder" Importance="High" />
  </Target>

</Project>

<!--
HOW TO - replace the placeholders:

1. TARGET_FRAMEWORK:
   - Look for "Runtime Type:" in the MelonLoader log (scripts/Get-MelonLoaderInfo.ps1 prints it)
   - net35 → replace with: net472 (NOT netstandard2.0!)
   - net6  → replace with: net6.0

   WARNING: netstandard2.0 does NOT work for Mono/net35 games!
   The mod is loaded but never initialised (no error message).

2. RUNTIME_FOLDER:
   - net35 → replace with: net35
   - net6  → replace with: net6

3. GAME_FOLDER: the full path to the game, e.g.:
   C:\Program Files (x86)\Steam\steamapps\common\GameName

4. GAME_NAME: the game's name (for the _Data folder), e.g.:
   Pet Idle → Pet Idle_Data

5. MODNAME and NAMESPACE: your mod's name, e.g.:
   PetIdleAccessibility

CHECKLIST BEFORE BUILD:
[ ] TargetFramework matches the Runtime Type in the log
[ ] RUNTIME_FOLDER matches the Runtime Type
[ ] Every GAME_FOLDER replaced
[ ] Every GAME_NAME replaced
[ ] decompiled, templates, Tests and recon are excluded
-->
