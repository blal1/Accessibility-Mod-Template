using MelonLoader;
using UnityEngine;

// ============================================================================
// Main only STARTS the pieces and drives the per-frame update. No feature code here, ever.
// Features are AccessibleScreen / AccessibleUI classes with nested [HarmonyPatch] hooks
// (docs/03-architecture.md, docs/04-building-screens.md); they are found automatically.
//
// Timing (appendix A, "Accessing game code"): most games allow Compat.PatchAll in OnInitializeMelon.
// If THIS game crashes or blocks when game types are touched that early, move the three Compat calls
// into OnSceneWasLoaded behind a "_patched" flag (first scene load).
// ============================================================================

[assembly: MelonInfo(typeof(NAMESPACE.Main), "MODNAME", "1.0.0", "AUTHOR")]
[assembly: MelonGame("DEVELOPER", "GAME_NAME")]

namespace NAMESPACE
{
    /// <summary>
    /// Mod entry point: initializes screen reader, settings, the AccessibilityMgr, and applies every hook
    /// with per-class failure isolation (Compat). Then forwards every frame to AccessibilityMgr.Update().
    /// </summary>
    public class Main : MelonMod
    {
        /// <summary>Debug mode: DebugLogger.Log(...) lines and every spoken text go to the log. Toggle with F12.</summary>
        public static bool DebugMode = false;

        public override void OnInitializeMelon()
        {
            var asm = typeof(Main).Assembly;
            ScreenReader.Initialize();
            ModConfig.Initialize();
            AccessibilityMgr.Initialize(asm);
            Compat.PatchAll(HarmonyInstance, asm);
            Compat.ScanStatics(asm);
            Compat.ReportStartup();
        }

        public override void OnUpdate()
        {
            // F12 = debug logging. Not an AccessibleKey on purpose: it must work even when the mod is broken.
            if (Input.GetKeyDown(KeyCode.F12))
            {
                DebugMode = !DebugMode;
                MelonLogger.Msg($"Debug mode {(DebugMode ? "on" : "off")}");
            }
            AccessibilityMgr.Update();
        }

        public override void OnSceneWasLoaded(int buildIndex, string sceneName)
        {
            DebugLogger.LogState($"Scene loaded: {sceneName}");
        }

        public override void OnApplicationQuit()
        {
            ScreenReader.Shutdown();
        }
    }
}
