using MelonLoader;

namespace NAMESPACE
{
    /// <summary>
    /// Mod settings stored with MelonPreferences (UserData/MelonPreferences.cfg), persisted between sessions.
    /// This class only holds the VALUES. The accessible settings menu is templates/shared/AccessibleModSettings.cs.template
    /// (an AccessibleUI opened with Ctrl+F11), so it follows the same focus, key and localization rules as every screen.
    ///
    /// Integration:
    /// 1. Call ModConfig.Initialize() in Main.OnInitializeMelon(), before AccessibilityMgr.Initialize().
    /// 2. Read ModConfig.Verbosity etc. wherever a component decides how much to say.
    /// </summary>
    public static class ModConfig
    {
        private static MelonPreferences_Category _category;

        // --- Add your settings here ---
        private static MelonPreferences_Entry<int> _verbosity;
        private static MelonPreferences_Entry<bool> _announceEmptyStates;

        /// <summary>Announcement detail level: 0=minimal, 1=normal, 2=verbose.</summary>
        public static int Verbosity
        {
            get => _verbosity.Value;
            set => _verbosity.Value = value;
        }

        /// <summary>Whether to announce empty states ("No items", "Inventory empty").</summary>
        public static bool AnnounceEmptyStates
        {
            get => _announceEmptyStates.Value;
            set => _announceEmptyStates.Value = value;
        }

        /// <summary>Creates the preferences. Call once in OnInitializeMelon().</summary>
        public static void Initialize()
        {
            _category = MelonPreferences.CreateCategory("MODNAME", "MODNAME Accessibility Settings");

            _verbosity = _category.CreateEntry("Verbosity", 1,
                description: "Announcement detail level: 0=minimal, 1=normal, 2=verbose");

            _announceEmptyStates = _category.CreateEntry("AnnounceEmptyStates", true,
                description: "Announce when lists or inventories are empty");
        }

        /// <summary>Writes the settings to disk. Called when the settings menu closes.</summary>
        public static void Save() => MelonPreferences.Save();
    }
}
