using BepInEx.Configuration;

namespace NAMESPACE
{
    /// <summary>
    /// Mod settings stored with the BepInEx ConfigFile (BepInEx/config/com.AUTHOR.MODNAME.cfg), persisted between sessions.
    /// This class only holds the VALUES. The accessible settings menu is templates/shared/AccessibleModSettings.cs.template
    /// (an AccessibleUI opened with Ctrl+F11), so it follows the same focus, key and localization rules as every screen.
    ///
    /// Integration:
    /// 1. Call ModConfig.Initialize(Config) in Main.Awake(), before AccessibilityMgr.Initialize().
    /// 2. Read ModConfig.Verbosity etc. wherever a component decides how much to say.
    /// </summary>
    public static class ModConfig
    {
        private static ConfigFile _config;

        // --- Add your settings here ---
        private static ConfigEntry<int> _verbosity;
        private static ConfigEntry<bool> _announceEmptyStates;

        /// <summary>Announcement detail level: 0=minimal, 1=normal, 2=verbose.</summary>
        public static int Verbosity
        {
            get => _verbosity.Value;
            set => _verbosity.Value = value;
        }

        /// <summary>Whether to announce empty states ("No items", "Inventory empty").</summary>
        public static bool AnnounceEmptyStates
        {
            get => _announceEmptyStates.Value;
            set => _announceEmptyStates.Value = value;
        }

        /// <summary>Binds the settings. Call once in Awake(): ModConfig.Initialize(Config);</summary>
        public static void Initialize(ConfigFile config)
        {
            _config = config;

            _verbosity = config.Bind("Accessibility", "Verbosity", 1,
                new ConfigDescription("Announcement detail level: 0=minimal, 1=normal, 2=verbose",
                    new AcceptableValueRange<int>(0, 2)));

            _announceEmptyStates = config.Bind("Accessibility", "AnnounceEmptyStates", true,
                "Announce when lists or inventories are empty");
        }

        /// <summary>Writes the settings to disk. Called when the settings menu closes.</summary>
        public static void Save() => _config?.Save();
    }
}
