<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- IMPORTANT: choose the TargetFramework that matches the game!
         Most BepInEx Mono games: net472
         Newer games on .NET 6+: net6.0
         Check what other BepInEx mods for this game use -->
    <TargetFramework>TARGET_FRAMEWORK</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>

    <AssemblyName>MODNAME</AssemblyName>
    <RootNamespace>NAMESPACE</RootNamespace>
  </PropertyGroup>

  <!-- IMPORTANT: keep decompiled game code and tooling out of the build! -->
  <ItemGroup>
    <Compile Remove="decompiled\**" />
    <Compile Remove="templates\**" />
    <Compile Remove="Tests\**" />
    <Compile Remove="recon\**" />
  </ItemGroup>

  <!-- Localization: Localization/<language>/<Feature>.txt (KEY<TAB>TEXT<TAB>COMMENT) are embedded in the DLL.
       LocalizationUtils reads them as resources "Localization/<language>/<file>". See docs/03-architecture.md -->
  <ItemGroup>
    <EmbeddedResource Include="Localization\**\*.txt" LogicalName="Localization/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- BepInEx references -->
  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>GAME_FOLDER\BepInEx\core\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>GAME_FOLDER\BepInEx\core\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Unity references (from the game's Managed folder) -->
  <ItemGroup>
    <Reference Include="UnityEngine">
      <HintPath>GAME_FOLDER\GAME_NAME_Data\Managed\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>GAME_FOLDER\GAME_NAME_Data\Managed\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>GAME_FOLDER\GAME_NAME_Data\Managed\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>GAME_FOLDER\GAME_NAME_Data\Managed\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- TextMeshPro: most Unity games show text with it (ReflectionHelper and AccessibleFEATURENAME use TMPro.TMP_Text). Remove if the game has no Unity.TextMeshPro.dll. -->
    <Reference Include="Unity.TextMeshPro">
      <HintPath>GAME_FOLDER\GAME_NAME_Data\Managed\Unity.TextMeshPro.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>GAME_FOLDER\GAME_NAME_Data\Managed\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Game assembly -->
  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>GAME_FOLDER\GAME_NAME_Data\Managed\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- After build: copy the DLL to the BepInEx plugins folder -->
  <Target Name="CopyToPlugins" AfterTargets="Build">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="GAME_FOLDER\BepInEx\plugins\" />
    <Message Text="Copied $(TargetFileName) to BepInEx plugins folder" Importance="High" />
  </Target>

</Project>

<!--
HOW TO - replace the placeholders:

1. TARGET_FRAMEWORK:
   - Most BepInEx Mono games: net472
   - Newer games (.NET 6+): net6.0
   - Check what other BepInEx mods use, or the DLLs in BepInEx/core/

2. GAME_FOLDER: the full path to the game, e.g.:
   C:\Program Files (x86)\Steam\steamapps\common\GameName

3. GAME_NAME: the game's name (for the _Data folder), e.g.:
   Pet Idle → Pet Idle_Data

4. MODNAME and NAMESPACE: your mod's name, e.g.:
   PetIdleAccessibility

CHECKLIST BEFORE BUILD:
[ ] TargetFramework chosen to match the game
[ ] Every GAME_FOLDER replaced
[ ] Every GAME_NAME replaced
[ ] decompiled, templates, Tests and recon are excluded
[ ] Output goes to BepInEx\plugins\ (not Mods\)
-->
