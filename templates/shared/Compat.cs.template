using System;
using System.Collections.Generic;
using System.Linq;
using System.Reflection;
using System.Runtime.CompilerServices;
using HarmonyLib;

namespace NAMESPACE
{
    /// <summary>
    /// Game-update report. The mod reaches into the game by member name (Harmony targets, private fields);
    /// an update that renames one used to make a screen go silent with no explanation. Every break is collected here:
    /// - PatchAll(): each [HarmonyPatch] class is applied ON ITS OWN, so one broken target never stops the others.
    /// - ScanStatics(): every `static readonly` FieldInfo/MethodInfo resolved by name that came back null.
    /// - MissingAtRuntime(): a ReflectionHelper name that no longer exists, reported once each.
    /// The count is spoken once at startup and appended to F1; the log lists every member ("COMPAT:" lines).
    /// Offline, BEFORE launching a new game version: the GameCompatTests in templates/tests.
    /// See docs/05-quality-and-updates.md.
    /// </summary>
    public static class Compat
    {
        private static readonly List<string> _problems = new List<string>();
        private static readonly HashSet<string> _runtimeSeen = new HashSet<string>();

        /// <summary>
        /// Replaces harmony.PatchAll(). Call where game types are safe to touch (OnInitializeMelon / Awake for most games;
        /// the first OnSceneWasLoaded if early access crashes this game, see appendix A).
        /// </summary>
        public static void PatchAll(HarmonyLib.Harmony harmony, Assembly modAssembly)
        {
            foreach (var type in SafeTypes(modAssembly))
            {
                if (!type.GetCustomAttributes(typeof(HarmonyPatch), false).Any()) continue;
                try { harmony.CreateClassProcessor(type).Patch(); }
                catch (Exception e) { Add($"{type.FullName}: patch failed ({(e.InnerException ?? e).Message})"); }
            }
        }

        /// <summary>Finds `static readonly` FieldInfo/MethodInfo/PropertyInfo fields that resolved to null.</summary>
        public static void ScanStatics(Assembly modAssembly)
        {
            foreach (var type in SafeTypes(modAssembly))
            {
                try { RuntimeHelpers.RunClassConstructor(type.TypeHandle); }
                catch (Exception e)
                {
                    Add($"{type.Name}: static init failed ({e.InnerException?.Message ?? e.Message})");
                    continue;
                }
                foreach (var f in type.GetFields(BindingFlags.Static | BindingFlags.NonPublic | BindingFlags.Public))
                {
                    if (f.IsInitOnly && typeof(MemberInfo).IsAssignableFrom(f.FieldType) && f.GetValue(null) == null)
                        Add($"{type.Name}.{f.Name}: game member not found");
                }
            }
        }

        /// <summary>Called by ReflectionHelper when a member name does not exist in this game build. Reported once.</summary>
        public static void MissingAtRuntime(Type owner, string member)
        {
            var key = $"{owner.FullName}.{member}";
            lock (_problems)
            {
                if (!_runtimeSeen.Add(key)) return;
            }
            Add($"{key}: not found at runtime");
        }

        /// <summary>Call once after PatchAll + ScanStatics: logs the result and speaks the count if anything broke.</summary>
        public static void ReportStartup()
        {
            int count;
            lock (_problems) count = _problems.Count;
            if (count == 0)
            {
                DebugLogger.Info("COMPAT: every game member the mod uses was found");
                return;
            }
            DebugLogger.Warn($"COMPAT: {count} problem(s) with this game version");
            AccessibilityMgr.OutputNotification(Summary());
        }

        /// <summary>The spoken warning, or null when everything resolved. AccessibilityMgr appends it to F1.</summary>
        public static string Summary()
        {
            int count;
            lock (_problems) count = _problems.Count;
            return count == 0 ? null : LocalizationUtils.Format(LocalizationKey.GLOBAL_COMPAT_PROBLEMS, count);
        }

        private static void Add(string problem)
        {
            lock (_problems) _problems.Add(problem);
            DebugLogger.Warn($"COMPAT: {problem}");
        }

        private static IEnumerable<Type> SafeTypes(Assembly asm)
        {
            try { return asm.GetTypes(); }
            catch (ReflectionTypeLoadException e) { return e.Types.Where(t => t != null); }
        }
    }
}
